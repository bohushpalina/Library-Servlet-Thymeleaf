<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="library_unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>

        <class>com.example.lab5_web.library.entity.Author</class>
        <class>com.example.lab5_web.library.entity.Book</class>
        <class>com.example.lab5_web.library.entity.BookCopy</class>
        <class>com.example.lab5_web.library.entity.Librarian</class>
        <class>com.example.lab5_web.library.entity.Loan</class>
        <class>com.example.lab5_web.library.entity.Reader</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/library?characterEncoding=utf8&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="lib_user"/>
            <property name="jakarta.persistence.jdbc.password" value="Lib12345!"/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
